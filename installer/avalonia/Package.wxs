<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Pintora" Manufacturer="Pintora contributors" Version="$(var.PintoraVersion)"
           UpgradeCode="FF40AC8A-E055-4AB5-AE29-915B0D3B1B59">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Pintora is already installed."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="Main" Title="Pintora">
      <Files Directory="INSTALLFOLDER" Include="..\..\publish\win-x64\**">
        <Exclude Files="**\*.pdb" />
      </Files>
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Pintora" />
    </StandardDirectory>
  </Fragment>
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Pintora">
        <Component Id="ApplicationShortcut" Guid="B4991BC5-FF13-46EC-9344-37C89B9693FC">
          <Shortcut Id="StartMenuShortcut" Name="Pintora"
                    Description="Pintora raster graphics editor"
                    Target="[INSTALLFOLDER]Pintora.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Pintora" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Fragment>
</Wix>
