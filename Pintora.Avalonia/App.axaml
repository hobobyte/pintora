<Application xmlns="https://github.com/avaloniaui"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pintora.Avalonia.App">
  <Application.Styles>
    <fluent:FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#FFFDF8" />
      <Setter Property="Foreground" Value="#1D2633" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#1D2633" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#1D2633" />
      <Setter Property="BorderBrush" Value="#D7DCE3" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#E8F1FF" />
      <Setter Property="BorderBrush" Value="#3B8CFF" />
    </Style>
  </Application.Styles>
</Application>
