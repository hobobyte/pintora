<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Pintora</AssemblyName>
    <RootNamespace>Pintora.Avalonia</RootNamespace>
    <Version>0.0.2-alpha</Version>
    <AssemblyVersion>0.0.2.0</AssemblyVersion>
    <FileVersion>0.0.2.0</FileVersion>
    <InformationalVersion>0.0.2-alpha</InformationalVersion>
    <Authors>Pintora contributors</Authors>
    <Product>Pintora Raster Editor</Product>
    <ApplicationIcon>Pintora.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\Pinta.Resources.Neutral\Pinta.Resources.Neutral.csproj" />
    <ProjectReference Include="..\..\..\core\Pinta.Core\Pinta.Core.csproj" />
    <ProjectReference Include="..\..\..\application\Pinta.Application\Pinta.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pintora.Avalonia.Tests" />
  </ItemGroup>

  <!-- Optional compiled translations (build the GTK project with -p:BuildTranslations=true). -->
  <ItemGroup>
    <None Include="../../gtk/build/bin/locale/**/pinta.mo" Link="locale/%(RecursiveDir)pinta.mo" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
